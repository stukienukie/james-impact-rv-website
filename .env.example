# Copy to .env.local and fill in. Never commit real values.

# --- Email (required for contact form delivery) ---
# Resend API key. Get from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. MUST be on a domain verified in Resend.
# The old default (onboarding@resend.dev) only delivers to the Resend account
# owner, so real leads never arrive. Verify impactrvrepair.com in Resend first.
CONTACT_FROM_EMAIL="Impact RV Repair <leads@impactrvrepair.com>"

# Where lead notifications go.
CONTACT_TO_EMAIL=james@impactrvrepair.com

# --- GoHighLevel ---
# Inbound webhook URL. In GHL: Automation > Workflows > add an "Inbound Webhook"
# trigger and copy its URL. Leave blank until the account exists — the contact
# form skips the webhook entirely when unset.
GHL_WEBHOOK_URL=

# Chat widget ID. In GHL: Sites > Chat Widget > copy the widget ID.
# Leave blank and no widget script is loaded at all.
NEXT_PUBLIC_GHL_WIDGET_ID=

# --- Blog image generation (optional, Monox internal) ---
GOOGLE_AI_API_KEY=
